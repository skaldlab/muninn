# Install-/compile-time overrides for scanner dependencies.
# Applied by `make scanners-lock` and the Docker image `uv pip install`.
#
# checkov 3.2.531 requires asteval 1.0.6 exactly. That release is affected by
# GHSA-89v8-rhwq-hf77 (CVE-2026-55244) and GHSA-9w56-46f6-3qhx. Force the
# patched line until checkov loosens or drops the pin. Hashes are required
# because image install uses uv pip install --require-hashes.
asteval==1.0.10 \
    --hash=sha256:46a4ed13cc2e4a29a21418f89dedd57db70d98eb96db0fb4c441d4edb2f5afed \
    --hash=sha256:8d805fa8084aa12204715f799430f0012a0db38b42e997f9f11a9637ad59855f

# semgrep still requires mcp==1.29.0, which is affected by GHSA-5h93-6whr-6q8j,
# GHSA-84m7-p3x7-pcfv, GHSA-rwrf-2pqf-9j8j, and GHSA-w4fh-qvv9-3v23. Force the
# patched 1.30.0 line until semgrep loosens its pin.
mcp==1.30.0 \
    --hash=sha256:445414625fce5c295faa505bb11bacece661ab6f4028d57c935db57820b7a3e4 \
    --hash=sha256:666edb5009503e1047c9d60346a756f94b261f05cc2625f23d41c728ffc484d0

# semgrep still requires opentelemetry-api/sdk/exporter ~=1.37.0 and
# instrumentation ~=0.58b0. opentelemetry-api before 1.45.1 is affected by
# GHSA-xcq7-p3pf-p88h (unbounded tracestate parsing). Force the patched
# OpenTelemetry stack until semgrep loosens those pins.
