# Top-level pins for the pip-installed scanners. Renovate keeps these current;
# requirements-scanners.txt is the hash-locked, multi-arch output compiled from
# this file (make scanners-lock). Do not edit the .txt by hand.
semgrep==1.176.0
# checkov 3.2.532+ and 3.3.x pull ecdsa>=0.19.0,<1.0.0; current ecdsa releases
# are affected by PYSEC-2026-1325 / CVE-2024-23342 with no fixed release yet.
# Keep checkov at 3.2.531 until checkov drops/replaces ecdsa or a fixed ecdsa is available.
checkov==3.2.531
zizmor==1.30.0

