# newest checkov that accepts the patched aiohttp>=3.14.1 floor below. Move back
# up to the latest checkov once a >=3.3 release lifts the aiohttp<3.14 cap.
checkov==3.2.531
zizmor==1.26.1

# Security floor for checkov's aiohttp dependency: keep it on the patched line.
aiohttp>=3.14.1

