# Top-level pins for the pip-installed scanners. Renovate keeps these current;
# requirements-scanners.txt is the hash-locked, multi-arch output compiled from
# this file (make scanners-lock). Do not edit the .txt by hand.
semgrep==1.172.0
# checkov 3.3.x caps aiohttp<3.14.0, which strands it on a CVE-affected aiohttp
# line (GHSA-4fvr-rgm6-gqmc, GHSA-jg22-mg44-37j8, and others). 3.2.531 is the
# newest checkov that accepts the patched aiohttp>=3.14.3 floor below. Move back
# up to the latest checkov once a >=3.3 release lifts the aiohttp<3.14 cap.
checkov==3.2.531
zizmor==1.29.0

# Security floor for checkov's aiohttp dependency: keep it on the patched line.
aiohttp>=3.14.3

# Security floor for checkov's GitPython dependency (GHSA-2f96-g7mh-g2hx,
# GHSA-956x-8gvw-wg5v, GHSA-rwj8-pgh3-r573, GHSA-v396-v7q4-x2qj,
# GHSA-94p4-4cq8-9g67). checkov allows gitpython<4,>=3.1.30; keep the lock on
# the patched line.
gitpython>=3.1.58

# Security floor for checkov's cryptography dependency (GHSA-g6cj-pr64-35w5 /
# CVE-2026-69247: PKCS#7 EnvelopedData Bleichenbacher oracle). Fixed in 50.0.0.
cryptography>=50.0.0

