# Top-level pins for the pip-installed scanners. Renovate keeps these current;
# requirements-scanners.txt is the hash-locked, multi-arch output compiled from
# this file (make scanners-lock). Do not edit the .txt by hand.
semgrep==1.168.0
# checkov 3.3.x caps aiohttp<3.14.0, which strands it on a CVE-affected aiohttp
